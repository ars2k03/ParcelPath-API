generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  COURIER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum ParcelType {
  DOCUMENT
  PACKAGE
  FRAGILE
}

enum ShipmentStatus {
  PENDING
  COURIER_ASSIGNED
  PICKED_UP
  AT_ORIGIN_HUB
  IN_TRANSIT
  AT_DESTINATION_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum AuditAction {
  USER_ROLE_CHANGED
  USER_STATUS_CHANGED
  HUB_CREATED
  HUB_UPDATED
  HUB_DELETED
  SHIPMENT_CREATED
  SHIPMENT_UPDATED
  SHIPMENT_DELETED
  SHIPMENT_CANCELLED
  SHIPMENT_STATUS_CHANGED
  COURIER_ASSIGNED
  PAYMENT_COMPLETED
  PAYMENT_REFUNDED
}

model User {
  id        String     @id @default(uuid(7))
  name      String
  email     String     @unique
  password  String?
  phone     String?
  avatarUrl String?
  googleId  String?    @unique
  role      Role       @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  refreshTokens     RefreshToken[]
  shipments         Shipment[]      @relation("CustomerShipments")
  assignedShipments Shipment[]      @relation("CourierShipments")
  trackingEvents    TrackingEvent[]
  payments          Payment[]
  auditLogs         AuditLog[]

  @@index([role, status])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid(7))
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Hub {
  id        String    @id @default(uuid(7))
  name      String    @unique
  code      String    @unique
  city      String
  address   String
  phone     String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  originShipments      Shipment[]      @relation("OriginHub")
  destinationShipments Shipment[]      @relation("DestinationHub")
  currentShipments     Shipment[]      @relation("CurrentHub")
  trackingEvents       TrackingEvent[]

  @@index([city])
  @@index([deletedAt])
  @@map("hubs")
}

model Shipment {
  id               String         @id @default(uuid(7))
  trackingNumber   String         @unique
  customerId       String
  courierId        String?
  originHubId      String
  destinationHubId String
  currentHubId     String?
  senderName       String
  senderPhone      String
  pickupAddress    String
  receiverName     String
  receiverPhone    String
  deliveryAddress  String
  parcelType       ParcelType
  weightKg         Decimal        @db.Decimal(8, 2)
  description      String?
  price            Decimal        @db.Decimal(10, 2)
  status           ShipmentStatus @default(PENDING)
  proofOfDelivery  String?
  failureReason    String?
  paidAt           DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  customer       User            @relation("CustomerShipments", fields: [customerId], references: [id])
  courier        User?           @relation("CourierShipments", fields: [courierId], references: [id])
  originHub      Hub             @relation("OriginHub", fields: [originHubId], references: [id])
  destinationHub Hub             @relation("DestinationHub", fields: [destinationHubId], references: [id])
  currentHub     Hub?            @relation("CurrentHub", fields: [currentHubId], references: [id])
  trackingEvents TrackingEvent[]
  payments       Payment[]

  @@index([customerId, status])
  @@index([courierId, status])
  @@index([status, createdAt])
  @@index([originHubId])
  @@index([destinationHubId])
  @@index([deletedAt])
  @@map("shipments")
}

model TrackingEvent {
  id         String         @id @default(uuid(7))
  shipmentId String
  status     ShipmentStatus
  hubId      String?
  actorId    String?
  note       String?
  createdAt  DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  hub      Hub?     @relation(fields: [hubId], references: [id])
  actor    User?    @relation(fields: [actorId], references: [id])

  @@index([shipmentId, createdAt])
  @@map("tracking_events")
}

model Payment {
  id                    String        @id @default(uuid(7))
  shipmentId            String
  userId                String
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("bdt")
  status                PaymentStatus @default(PENDING)
  stripeSessionId       String        @unique
  stripePaymentIntentId String?       @unique
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([shipmentId, status])
  @@index([userId, status])
  @@map("payments")
}

model AuditLog {
  id        String      @id @default(uuid(7))
  actorId   String?
  action    AuditAction
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId])
  @@index([action, createdAt])
  @@map("audit_logs")
}
